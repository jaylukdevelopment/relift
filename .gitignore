# --- Relift local artefacts -------------------------------------------
# Run output may contain hostnames, banners and internal addresses.
.relift-runs/
*.run.json

# Scope files describe your environment. Keep the example, ignore the real ones.
scope.json
scope.*.json
!examples/scope.example.json

# Local provider config may reference API keys.
relift.config.json

# Local lab fixtures: scopes and credentials used against your own containers.
.lab/

# --- Secrets --------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Editor / OS ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Site -----------------------------------------------------------------
site/node_modules/
site/.next/
site/.taste-skill/
site/next-env.d.ts
site/tsconfig.tsbuildinfo

# --- Packaging ------------------------------------------------------------
# Generated by `pyinstaller packaging/desktop_entry.py`; the recipe is in
# .github/workflows/release.yml and docs/08-DESKTOP.md.
*.spec
