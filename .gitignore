# --- Relift local artefacts -------------------------------------------
# Run output may contain hostnames, banners and internal addresses.
.relift-runs/
*.run.json

# Scope files describe your environment. Keep the example, ignore the real ones.
scope.json
scope.*.json
!examples/scope.example.json

# Local provider config may reference API keys.
relift.config.json

# Local lab fixtures: scopes and credentials used against your own containers.
.lab/

# --- Secrets --------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Editor / OS ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Site -----------------------------------------------------------------
# The marketing site and its download mirror are deployed separately; the
# repository ships the tool, not the page. Local builds stay out of git.
site/
site/node_modules/
site/.next/
site/.taste-skill/
site/next-env.d.ts
site/tsconfig.tsbuildinfo

# --- Packaging ------------------------------------------------------------
# PyInstaller writes a .spec next to the working directory; the one recipe we
# maintain lives in packaging/ and is tracked.
*.spec
!packaging/relift-desktop.spec
